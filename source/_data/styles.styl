
.collection-year {
    color: $post-title-color;
}


.posts-collapse .post-content .collection-year::before {
    background: $post-title-color;
}

.post-body h1:not(.site-title),
.post-body h2:not(.site-title),
.post-body h3:not(.site-title),
.post-body h4:not(.site-title),
.post-body h5:not(.site-title),
.post-body h6:not(.site-title) {
    color: $post-title-color;
}

.post-body h1 {
    border-bottom: 2px solid $post-title-color;
}

.post-body h1, .post-body h2, .post-body h3 {
    border-bottom: 1px dotted $theme-color;
}

.with-love {
    color: $post-title-color;
}

.post-body .visual-image-box {
    text-align: center;
    line-height: 1.6rem;
    z-index: 10;
}

.post-body .visual-image-box .stroke {
    background: $post-title-bg-color;
}

.post-body .visual-image-box .stroke {
    color: $post-title-bg-color;
    position: relative;
    @media all and (max-width: 960px) {
        display: none;
    }
}

.post-body .visual-image-box .stroke::after {
    content: " ";
    width: 100%;
    height: 120%;
    position: absolute;
    bottom: -2px;
    left: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0) 80%, $post-title-bg-color 80%);
}

.post-body .visual-image-box .plain {
    position: relative;
    z-index: 5;
    color: $post-title-color;
    font-weight: 800;
    text-shadow:
        calc(var(--stroke-width) * -1) calc(var(--stroke-width) * -1) 0 transparent,  
        var(--stroke-width) calc(var(--stroke-width) * -1) 0 transparent,
        calc(var(--stroke-width) * -1)  var(--stroke-width) 0 transparent,
        var(--stroke-width)  var(--stroke-width) 0 transparent;
}
.post-body .visual-image-box:nth-child(2) .plain,
.post-body .visual-image-box .plain.main-title, {
    background: $post-title-bg-color;
}

.post-body .visual-image {
    --stroke-width: 1px;
    margin-bottom: 20px;
    background: $post-title-bg-color;
    text-transform: capitalize;
    width: 100%;
    height: 200px
    font-weight: bolder;
    font-size: 2rem;
    @media all and (max-width: 960px) {
        font-size: 1.5rem;
    }
    @media all and (max-width: 600px) {
        font-size: 1.2rem;
    }
    display: flex;
    justify-content: center;
    align-items: center;
    text-shadow:
        calc(var(--stroke-width) * -1) calc(var(--stroke-width) * -1) 0 $post-title-color,  
        var(--stroke-width) calc(var(--stroke-width) * -1) 0 $post-title-color,
        calc(var(--stroke-width) * -1)  var(--stroke-width) 0 $post-title-color,
        var(--stroke-width)  var(--stroke-width) 0 $post-title-color;
}

.post-body .visual-image {
    position: relative;
}

.post-body .visual-image-deco {
    position: absolute;
    bottom: -25px; right: -10px;
    width: 180px;
    height: auto;
    z-index: 2;
    @media all and (max-width: 796px) {
        width: 110px;
    }
}

.main-inner .post-block,
.main-inner .post-block:not(:first-child):not(:first-child) {
    box-shadow: unset;
}

.pagination .page-number.current {
    background: $theme-color;
    border-color: $theme-color;
}

.back-to-top {
    background: $theme-color;
    opacity: 1;
}

.main-inner .pagination {
    background: transparent;
    box-shadow: unset;
}

.pagination .page-number {
    background: white;
    text-shadow:
        calc(var(--stroke-width) * -1) calc(var(--stroke-width) * -1) 0 $post-title-color,  
        var(--stroke-width) calc(var(--stroke-width) * -1) 0 $post-title-color,
        calc(var(--stroke-width) * -1)  var(--stroke-width) 0 $post-title-color,
        var(--stroke-width)  var(--stroke-width) 0 $post-title-color;
}

blockquote {
    border-left: 4px solid $theme-color;
    background: $body-bg-color;
    padding: 16px;
    font-style: italic;
}

blockquote code {
    font-weight: bolder;
    color: black;
    background: $theme-color;
}

blockquote code p {
    font-weight: bolder;
    color: black;
}

blockquote p {
    margin-bottom: 0;
}