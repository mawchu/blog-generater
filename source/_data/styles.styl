
.collection-year {
    color: $theme-color;
}


.posts-collapse .post-content .collection-year::before {
    background: $theme-color;
}

.post-body h1:not(.site-title) {
    color: $theme-color;
}

.with-love {
    color: $theme-color;
}

.post-body .visual-image-box {
    text-align: center;
    line-height: 1.6rem;
}


.post-body .visual-image-box div:nth-child(1),
.post-body .visual-image-box div:nth-child(2) {
    color: rgba(242, 193, 70, 1);
    @media all and (max-width: 960px) {
        display: none;
    }
}

.post-body .visual-image-box div:nth-child(3),
.post-body .visual-image-box div:nth-child(4) {
    color: white;
    font-weight: 800;
    text-shadow:
        calc(var(--stroke-width) * -1) calc(var(--stroke-width) * -1) 0 transparent,  
        var(--stroke-width) calc(var(--stroke-width) * -1) 0 transparent,
        calc(var(--stroke-width) * -1)  var(--stroke-width) 0 transparent,
        var(--stroke-width)  var(--stroke-width) 0 transparent;
}

.post-body .visual-image {
    --stroke-width: 1px;
    margin-bottom: 20px;
    background: $theme-color;
    text-transform: capitalize;
    width: 100%;
    height: 200px
    font-weight: bolder;
    font-size: 2rem;
    @media all and (max-width: 960px) {
        font-size: 1.5rem;
    }
    @media all and (max-width: 600px) {
        font-size: 1rem;
    }
    display: flex;
    justify-content: center;
    align-items: center;
    text-shadow:
        calc(var(--stroke-width) * -1) calc(var(--stroke-width) * -1) 0 white,  
        var(--stroke-width) calc(var(--stroke-width) * -1) 0 white,
        calc(var(--stroke-width) * -1)  var(--stroke-width) 0 white,
        var(--stroke-width)  var(--stroke-width) 0 white;
}